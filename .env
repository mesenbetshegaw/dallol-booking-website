#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.indexPage = ''

#--------------------------------------------------------------------
# DATABASE — use 127.0.0.1 (TCP) to bypass PostgreSQL peer auth
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = dallol_booking
database.default.username = postgres
database.default.password = 8640
database.default.DBDriver = Postgre
database.default.DBPrefix  =
database.default.port      = 5432
database.default.schema    = public

#--------------------------------------------------------------------
# JWT
#--------------------------------------------------------------------
jwt.secret         = dallol_jwt_super_secret_key_2024_change_in_prod
jwt.expire         = 86400
jwt.refresh_expire = 604800

#--------------------------------------------------------------------
# ENCRYPTION — generated by: php spark key:generate
#--------------------------------------------------------------------
# (key:generate already wrote the key above, leave as-is)

encryption.key = hex2bin:388dc0b19650266fc82e9593e78dcb2d4e64022ea440d708542b8e5576461096